{
  "name": "mykids-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:run && npm run test:e2e:visual",
    "test:e2e:run": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "generate:session-secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"playwright.config.ts\" \"vitest.config.mts\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"playwright.config.ts\" \"vitest.config.mts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6",
    "vitest": "5.0.0"
  }
}
